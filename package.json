    "verify": "npm run check && node scripts/smoke-render.mjs && node scripts/interact.mjs",
    "test": "node scripts/interact.mjs",
    "images": "node scripts/optimize-images.mjs",
    "pages": "node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
