    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "keywords": [
