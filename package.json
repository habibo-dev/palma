{
  "name": "palma-meuble-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PALMA MEUBLE EURL — mobilier de bureau et mobilier scolaire, Constantine. Site vitrine (concept de présentation).",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
